{
  "name": "archerbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/bundle.test.mjs tests/worker.test.mjs tests/charts.test.mjs tests/multiplayer.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply archerbox-db --local",
    "db:remote": "wrangler d1 migrations apply archerbox-db --remote",
    "deploy": "npm run db:remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.160.1"
  }
}
