{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archerbox",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/signin-with-chatgpt",
      "/signout-with-chatgpt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archerbox-db",
      "database_id": "22fefeb4-7afd-4b0d-a7a1-85703905d1d5",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "archer-box.com",
      "custom_domain": true
    },
    {
      "pattern": "www.archer-box.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "live-matches-v1",
      "new_sqlite_classes": [
        "MatchRoom"
      ]
    }
  ]
}
