{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archerbox",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/signin-with-chatgpt", "/signout-with-chatgpt"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "archerbox-db",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "drizzle"
  }]
}
